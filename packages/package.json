{
  "private": true,
  "workspaces": ["fff-bun", "fff-node", "pi-fff"],
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "oxfmt . && oxlint --fix . && bun run typecheck",
    "check:ci": "oxfmt --check . && oxlint . && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0"
  }
}
