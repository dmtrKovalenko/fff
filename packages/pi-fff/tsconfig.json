{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    "paths": {
      "@ff-labs/fff-node": [
        "../fff-node/src/index.ts"
      ],
      "@ff-labs/fff-bun": [
        "../fff-bun/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "../fff-bun/src/embed.d.ts"
  ]
}
